{
  "name": "spjutsim-fea",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "fea.spjutsim.com",
      "custom_domain": true
    }
  ],
  "build": {
    "command": "python3 tools/audit-distribution.py --release-root build/distribution/web --require-approved"
  },
  "assets": {
    "directory": "./build/distribution/web"
  }
}
